<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.grain.platform.mapper.RoleMapper">

    <resultMap id="sysRoleResultMap" type="com.grain.platform.entity.SysRole">
        <id property="id" column="id"/>
        <result property="roleCode" column="role_code"/>
        <result property="roleName" column="role_name"/>
        <result property="roleDesc" column="role_desc"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="selectRoleCodesByUserId" resultType="string">
        select r.role_code
        from sys_user_role ur
                 join sys_role r on ur.role_id = r.id
        where ur.user_id = #{userId}
        order by r.id asc
    </select>

    <select id="selectAllRoleOptions" resultType="com.grain.platform.dto.user.RoleOptionResponse">
        select role_code,
               role_name,
               role_desc
        from sys_role
        order by id asc
    </select>

    <select id="selectRolesByCodes" resultMap="sysRoleResultMap">
        select id,
               role_code,
               role_name,
               role_desc,
               created_at,
               updated_at
        from sys_role
        where role_code in
        <foreach collection="roleCodes" item="roleCode" open="(" separator="," close=")">
            #{roleCode}
        </foreach>
        order by id asc
    </select>
</mapper>
